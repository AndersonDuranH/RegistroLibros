@page "/Prestamo/Edit/{PrestamoId:int}"
@rendermode InteractiveServer

@using RegistroLibro.Models
@using RegistroLibro.Services
@inject PrestamosServices prestamosService
@inject EstudiantesServices estudiantesService
@inject LibrosServices librosService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Modificar Préstamo de Libro</PageTitle>

<EditForm Model="Prestamo" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Pr&eacute;stamo #@PrestamoId</h5>
            </div>

            <div class="card-body">
                @* Estudiante *@
                <div class="mb-3">
                    <label class="form-label"><strong>Estudiante</strong></label>
                    <InputSelect class="form-select" @bind-Value="Prestamo.EstudianteId">
                        <option value="0" disabled>-- Elija un estudiante --</option>
                        @foreach (var estudiante in ListaEstudiantes)
                        {
                            <option value="@estudiante.EstudianteId">@estudiante.Nombres</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.EstudianteId)" />
                </div>

                @* Libro *@
                <div class="mb-3">
                    <label class="form-label"><strong>Libro</strong></label>
                    <InputSelect class="form-select" @bind-Value="Prestamo.LibroId">
                        <option value="0" disabled>-- Elija un libro --</option>
                        @foreach (var libro in ListaLibros)
                        {
                            <option value="@libro.LibroId">@libro.Titulo (@libro.Autor)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.LibroId)" />
                </div>

                @* Fecha Prestamo y Devolucion en fila *@
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><strong>Fecha de Pr&eacute;stamo</strong></label>
                        <InputDate class="form-control" @bind-Value="Prestamo.FechaPrestamo" />
                        <ValidationMessage For="(() => Prestamo.FechaPrestamo)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><strong>Fecha Estimada de Devoluci&oacute;n</strong></label>
                        <InputDate class="form-control" @bind-Value="Prestamo.FechaDevolucion" />
                        <ValidationMessage For="(() => Prestamo.FechaDevolucion)" />
                    </div>
                </div>

                @* Concepto *@
                <div class="mb-3">
                    <label class="form-label"><strong>Concepto / Observaci&oacute;n</strong></label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="Prestamo.Concepto" />
                    <ValidationMessage For="(() => Prestamo.Concepto)" />
                </div>
            </div>

            <div class="card-footer text-center mt-2">
                <a href="/Prestamo/Index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash ms-2" @onclick="MostrarConfirmacionEliminar"> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

@* Modal de Confirmación para Eliminar *@
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-danger">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirmar Eliminaci&oacute;n</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <p class="fs-6">¿Est&aacute; seguro de que desea eliminar permanentemente este pr&eacute;stamo <strong>#@PrestamoId</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal"><i class="bi bi-x-circle"></i> Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar"><i class="bi bi-trash"></i> S&iacute;, Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int PrestamoId { get; set; }
    public Prestamos Prestamo { get; set; } = new();
    public List<Estudiante> ListaEstudiantes { get; set; } = [];
    public List<Libros> ListaLibros { get; set; } = [];

    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        ListaEstudiantes = await estudiantesService.GetList(e => e.EstudianteId > 0);
        ListaLibros = await librosService.GetList(l => l.LibroId > 0);

        var prestamoBuscado = await prestamosService.Buscar(PrestamoId);
        if (prestamoBuscado != null)
        {
            Prestamo = prestamoBuscado;
        }
        else
        {
            toastService.ShowError("No se encontró el préstamo solicitado.");
            navigationManager.NavigateTo("/Prestamo/Index");
        }
    }

    private async Task Modificar()
    {
        if (Prestamo.EstudianteId <= 0)
        {
            toastService.ShowError("Debe seleccionar un estudiante válido.");
            return;
        }

        if (Prestamo.LibroId <= 0)
        {
            toastService.ShowError("Debe seleccionar un libro válido.");
            return;
        }

        if (Prestamo.FechaDevolucion < Prestamo.FechaPrestamo)
        {
            toastService.ShowError("La fecha de devolución no puede ser anterior a la fecha del préstamo.");
            return;
        }

        var guardado = await prestamosService.Guardar(Prestamo);
        if (guardado)
        {
            toastService.ShowSuccess("El préstamo se ha modificado exitosamente.");
            navigationManager.NavigateTo("/Prestamo/Index");
        }
        else
        {
            toastService.ShowError("Ocurrió un problema al modificar el préstamo.");
        }
    }

    private void MostrarConfirmacionEliminar()
    {
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarModal = false;
        var eliminado = await prestamosService.Eliminar(Prestamo.PrestamoId);
        if (eliminado)
        {
            toastService.ShowSuccess("El préstamo se eliminó correctamente.");
            navigationManager.NavigateTo("/Prestamo/Index");
        }
        else
        {
            toastService.ShowError("No se pudo eliminar el préstamo.");
        }
    }
}
